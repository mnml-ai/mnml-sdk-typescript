{
  "name": "@mnml-ai/sdk",
  "version": "0.1.0",
  "description": "The official TypeScript client for the mnml API: architecture renders, edits, enhancements and video.",
  "license": "MIT",
  "author": "mnml (https://mnml.ai)",
  "homepage": "https://developers.mnml.ai/sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnml-ai/mnml-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/mnml-ai/mnml-sdk-typescript/issues"
  },
  "keywords": [
    "mnml",
    "architecture",
    "rendering",
    "ai",
    "api",
    "sdk"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec:update": "node scripts/update-spec.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
